---
/**
 * 발주·협력 기관 네트워크 — 정부부처부터 학회까지 유형별로 보여 줍니다.
 * 데이터: src/data/clients.yaml
 */
import Icon from './Icon.astro';
import { getClientGroups } from '../lib/data';
import type { Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const groups = await getClientGroups();
const ICON: Record<string, string> = { gov: 'gov', public: 'building', research: 'scholar', association: 'users', society: 'book', industry: 'crane' };
---
<ul class="cnet">
  {groups.map((g, i) => (
    <li class="cnet__col reveal" style={`--d:${i * 0.06}s`}>
      <div class="cnet__head">
        <span class="cnet__icon"><Icon name={ICON[g.type]} size={20} /></span>
        <span class="cnet__n mono">
          {g.list.length}
        </span>
      </div>
      <h3 class="cnet__type">{lang === 'ko' ? g.ko : g.en}</h3>
      <ul class="cnet__list">
        {g.list.map((c) => (
          <li>
            {lang === 'ko' ? c.id : c.name_en}
            {lang === 'en' && c.short_en && <span class="mono"> {c.short_en}</span>}
          </li>
        ))}
      </ul>
    </li>
  ))}
</ul>

<style>
  .cnet { list-style: none; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  @media (min-width: 1100px) { .cnet { grid-template-columns: repeat(6, 1fr); } }
  .cnet__col { background: var(--surface); padding: 22px 20px 24px; display: flex; flex-direction: column; }
  .cnet__head { display: flex; justify-content: space-between; align-items: center; }
  .cnet__icon { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--paper-2); color: var(--navy); }
  .cnet__n { font-size: 30px; font-weight: 600; letter-spacing: -0.04em; color: var(--ink); line-height: 1; }
  .cnet__type { font-size: 15.5px; font-weight: 800; letter-spacing: -0.02em; margin-top: 18px; padding-bottom: 12px; border-bottom: 1.5px solid var(--ink); }
  .cnet__list { list-style: none; margin-top: 8px; display: grid; }
  .cnet__list li { padding: 8px 0; border-bottom: 1px dashed var(--line); font-size: 14px; font-weight: 600; color: var(--ink-2); line-height: 1.45; }
  .cnet__list li:last-child { border-bottom: 0; }
  .cnet__list .mono { font-size: 12.5px; color: var(--ink-3); font-weight: 500; }
  @media (max-width: 600px) { .cnet { grid-template-columns: 1fr 1fr; } .cnet__col { padding: 16px 14px 18px; } .cnet__list li { font-size: 13px; } .cnet__n { font-size: 24px; } }
</style>
