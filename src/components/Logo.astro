---
interface Props { inverse?: boolean }
const { inverse = false } = Astro.props;
const bg = inverse ? '#FFFFFF' : '#0F2A44';
const fg = inverse ? '#0F2A44' : '#FFFFFF';
---
<svg class="logo-mark" width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
  <rect width="36" height="36" rx="9" fill={bg} />
  <rect x="7" y="9" width="13" height="4" rx="2" fill={fg} />
  <rect x="12" y="16" width="17" height="4" rx="2" fill="#E8641C" />
  <rect x="7" y="23" width="9" height="4" rx="2" fill={fg} />
  <path d="M7 6.5v23" stroke={fg} stroke-opacity=".35" stroke-width="1" />
</svg>
