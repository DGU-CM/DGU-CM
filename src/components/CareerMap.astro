---
/**
 * CM 전공자 진로 지도 — 건설관리 전공자가 진출할 수 있는 분야를 소개합니다.
 * 내용: src/lib/careers.ts
 */
import Icon from './Icon.astro';
import { CAREER_PATHS } from '../lib/careers';
import type { Lang } from '../lib/i18n';

interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const ko = lang === 'ko';
---
<ul class:list={['cmap', { 'cmap--compact': compact }]}>
  {CAREER_PATHS.map((c, i) => (
    <li class="cmap__card reveal" style={`--d:${i * 0.05}s`}>
      <div class="cmap__top">
        <span class="cmap__icon"><Icon name={c.icon} size={22} /></span>
        <span class="cmap__no mono">{String(i + 1).padStart(2, '0')}</span>
      </div>
      <h3 class="cmap__title">{ko ? c.ko : c.en}</h3>
      <p class="cmap__role">{ko ? c.roleKo : c.roleEn}</p>
      {!compact && <p class="cmap__where">{ko ? c.whereKo : c.whereEn}</p>}
    </li>
  ))}
</ul>

<style>
  .cmap { list-style: none; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  @media (min-width: 1100px) { .cmap { grid-template-columns: repeat(4, 1fr); } }
  .cmap__card { position: relative; padding: 22px 22px 24px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); display: flex; flex-direction: column; gap: 10px; transition: transform .3s var(--ease), box-shadow .3s, border-color .3s; }
  .cmap__card::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 3px; border-radius: var(--radius) var(--radius) 0 0; background: var(--orange); transform: scaleX(0); transform-origin: left; transition: transform .4s var(--ease); }
  .cmap__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); border-color: transparent; }
  .cmap__card:hover::before { transform: scaleX(1); }
  .cmap__top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .cmap__icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: color-mix(in srgb, var(--orange) 10%, white); color: var(--orange-ink); }
  .cmap__no { font-size: 12.5px; font-weight: 600; color: var(--ink-3); }
  .cmap__title { font-size: 18px; font-weight: 800; letter-spacing: -0.03em; margin-top: 6px; }
  .cmap__role { font-size: 14.5px; color: var(--ink-2); line-height: 1.65; }
  .cmap__where { font-size: 13px; color: var(--ink-3); line-height: 1.6; padding-top: 10px; border-top: 1px dashed var(--line); margin-top: auto; }
  .cmap--compact .cmap__role { font-size: 14px; }
</style>
