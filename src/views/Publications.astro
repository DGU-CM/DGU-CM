---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site.config';
import { AREAS, getProjects, getFeatured, getPublications, getStats, clientNamer, isOngoing, url } from '../lib/data';
import { localePath, pick, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pick(lang);
const ko = lang === 'ko';
const L = (p: string) => url(localePath(lang, p));

const [projects, featured, pubs, stats, clientName] = await Promise.all([getProjects(), getFeatured(), getPublications(), getStats(), clientNamer()]);
// 주요 연구보고서: 주요 사례와 그 연계 과제 (완료된 과제만)
const keyIds = new Set(featured.flatMap((p) => [p.id, ...(p.related ?? [])]));
const reports = projects.filter((p) => keyIds.has(p.id) && !isOngoing(p));
const journals = pubs.filter((p) => p.type === 'journal');
const theses = pubs.filter((p) => p.type.startsWith('thesis'));

const groupByYear = <T,>(list: T[], y: (x: T) => number) => {
  const m = new Map<number, T[]>();
  list.forEach((x) => m.set(y(x), [...(m.get(y(x)) ?? []), x]));
  return [...m.entries()].sort((a, b) => b[0] - a[0]);
};
const reportYears = groupByYear(reports, (p) => p.end ?? p.start);
const journalYears = groupByYear(journals, (p) => p.year);
const thesisYears = groupByYear(theses, (p) => p.year);
const tabs = [
  { id: 'reports', label: t('주요 연구보고서', 'Key reports'), n: reports.length },
  { id: 'journals', label: t('학술논문', 'Journal papers'), n: journals.length },
  { id: 'theses', label: t('학위논문', 'Theses'), n: theses.length },
];
---
<Base lang={lang} path="/publications" title="Publications" description={t('DGU CM Lab 주요 연구보고서, 학술논문, 학위논문', 'DGU CM Lab — key research reports, journal papers and theses')}>
  <PageHero
    eyebrow="Publications"
    title="Publications"
    sub={t('연구는 보고서와 논문으로 남습니다', 'Research that leaves a record')}
    lead={t(`${stats.projectsTotal}여 건의 과제 결과보고서 가운데 주요 보고서와 학술논문, 학위논문을 정리했습니다. 목록은 분기마다 업데이트됩니다.`, `Key reports from our ${stats.projectsTotal}+ projects, plus journal papers and theses. Updated every quarter.`)}
  >
    {SITE.scholarUrl && <a class="btn btn--ghost" href={SITE.scholarUrl} target="_blank" rel="noopener"><Icon name="scholar" />{t('Google Scholar에서 전체 실적 보기', 'Full record on Google Scholar')}</a>}
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="tabs" role="tablist" aria-label={t('성과 유형', 'Publication type')} data-tabs>
        {tabs.map((tb, n) => (
          <button type="button" role="tab" id={`tab-${tb.id}`} aria-controls={`panel-${tb.id}`} aria-selected={n === 0 ? 'true' : 'false'} tabindex={n === 0 ? 0 : -1} class:list={['tab', { 'is-on': n === 0 }]}>
            {tb.label}<span class="mono">{tb.n}</span>
          </button>
        ))}
      </div>

      <div role="tabpanel" id="panel-reports" aria-labelledby="tab-reports" class="panel">
        <p class="panel__note">{ko ? <>주요 사례와 연계 과제의 결과보고서입니다. 각 사례의 문제·접근·성과는 <a href={L('/research#cases')}>Research › 주요 연구 사례</a>에서 볼 수 있습니다.</> : <>Final reports from our key cases and their related projects. See <a href={L('/research#cases')}>Research › Key cases</a> for the story behind each.</>}</p>
        {reportYears.map(([y, list]) => (
          <div class="ygroup">
            <h2 class="ygroup__y mono">{y}</h2>
            <ul class="pubs">
              {list.map((p) => (
                <li class="pub">
                  <span class="pub__icon" style={`--c:${AREAS[p.area].color}`}><Icon name="doc" size={18} /></span>
                  <div>
                    <p class="pub__title">{ko ? p.title : p.title_en ?? p.title}</p>
                    <p class="pub__meta">{clientName(p.client, lang)} · {t('연구보고서', 'Research report')} · {ko ? AREAS[p.area].short : AREAS[p.area].shortEn}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      {[
        { id: 'journals', years: journalYears, label: t('학술논문', 'Journal paper') },
        { id: 'theses', years: thesisYears, label: t('학위논문', 'Thesis') },
      ].map((g) => (
        <div role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`} class="panel" hidden>
          {g.years.length === 0 ? (
            <div class="empty card">
              <span class="empty__icon"><Icon name="doc" size={40} /></span>
              <div>
                <p class="empty__hand">{t(`${g.label} 목록을 정리하고 있어요!`, 'We are compiling this list!')}</p>
                <p class="empty__text">{t(`${g.label} 정보는 다음 분기 업데이트에 추가됩니다.`, 'It will be added in the next quarterly update.')}{SITE.scholarUrl && t(' 그전까지는 Google Scholar에서 전체 실적을 확인할 수 있습니다.', ' Meanwhile, see the full record on Google Scholar.')}</p>
                {SITE.scholarUrl && <a class="btn btn--primary" style="margin-top:20px" href={SITE.scholarUrl} target="_blank" rel="noopener"><Icon name="scholar" />Google Scholar</a>}
              </div>
            </div>
          ) : (
            g.years.map(([y, list]) => (
              <div class="ygroup">
                <h2 class="ygroup__y mono">{y}</h2>
                <ul class="pubs">
                  {list.map((p) => {
                    const link = p.doi ? `https://doi.org/${p.doi}` : p.url;
                    return (
                      <li class="pub">
                        <span class="pub__icon"><Icon name={p.type === 'journal' ? 'book' : 'scholar'} size={18} /></span>
                        <div>
                          <p class="pub__title">{link ? <a href={link} target="_blank" rel="noopener">{p.title} <Icon name="external" size={14} /></a> : p.title}</p>
                          <p class="pub__meta">{p.authors}{p.venue && ` · ${p.venue}`}{p.type === 'thesis-phd' ? t(' · 박사학위논문', ' · Ph.D. thesis') : p.type === 'thesis-ms' ? t(' · 석사학위논문', ' · M.S. thesis') : ''}</p>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          )}
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  const list = document.querySelector<HTMLElement>('[data-tabs]');
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((x) => {
        const on = x === tab;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        x.classList.toggle('is-on', on);
        document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
      });
    };
    tabs.forEach((tab, n) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const next = tabs[(n + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
          select(next);
          next.focus();
        }
      });
    });
  }
</script>

<style>
  .tabs { display: flex; gap: 6px; border-bottom: 1.5px solid var(--ink); margin-bottom: 40px; overflow-x: auto; }
  .tab { display: inline-flex; align-items: center; gap: 10px; padding: 14px 20px; border: 0; background: transparent; cursor: pointer; font-size: 17px; font-weight: 700; color: var(--ink-3); position: relative; white-space: nowrap; }
  .tab span { font-size: 12.5px; font-weight: 500; padding: 2px 8px; border-radius: 999px; background: var(--paper-2); color: var(--ink-3); }
  .tab.is-on { color: var(--ink); }
  .tab.is-on::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: -2px; height: 4px; border-radius: 2px; background: var(--orange); }
  .tab.is-on span { background: var(--ink); color: #fff; }
  .panel__note { color: var(--ink-3); font-size: 14.5px; margin-bottom: 32px; }
  .panel__note a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .ygroup { display: grid; gap: 8px; padding: 28px 0; border-top: 1px solid var(--line); }
  @media (min-width: 900px) { .ygroup { grid-template-columns: 140px 1fr; gap: 32px; } }
  .ygroup__y { font-size: 28px; font-weight: 600; letter-spacing: -0.04em; color: var(--ink); line-height: 1.2; }
  .pubs { list-style: none; display: grid; gap: 4px; }
  .pub { display: grid; grid-template-columns: 40px 1fr; gap: 14px; padding: 12px 0; align-items: start; }
  .pub__icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: color-mix(in srgb, var(--c, var(--ink-3)) 12%, white); color: var(--c, var(--ink-2)); }
  .pub__title { font-weight: 700; letter-spacing: -0.02em; line-height: 1.5; font-size: 16.5px; }
  .pub__title a { display: inline-flex; gap: 6px; align-items: center; }
  .pub__title a:hover { color: var(--blue); }
  .pub__meta { font-size: 14px; color: var(--ink-3); margin-top: 2px; }
  .empty { display: flex; flex-wrap: wrap; align-items: center; gap: 32px; padding: clamp(28px, 4vw, 48px); }
  .empty__icon { width: 96px; height: 96px; border-radius: 24px; display: grid; place-items: center; background: color-mix(in srgb, var(--orange) 10%, white); color: var(--orange-ink); }
  .empty__hand { font-size: 22px; font-weight: 800; letter-spacing: -0.03em; color: var(--ink); line-height: 1.3; }
  .empty__text { margin-top: 10px; color: var(--ink-2); max-width: 520px; }
</style>
