---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ClientNetwork from '../components/ClientNetwork.astro';
import { photoImg } from '../lib/images';
import { AREAS, AREA_ORDER, getProjects, getFeatured, getStats, getClientGroups, clientNamer, countBy, isOngoing, period, url } from '../lib/data';
import { localePath, pick, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pick(lang);
const ko = lang === 'ko';
const L = (p: string) => url(localePath(lang, p));

const [projects, featured, stats, groups, clientName] = await Promise.all([getProjects(), getFeatured(), getStats(), getClientGroups(), clientNamer()]);
const byId = new Map(projects.map((p) => [p.id, p]));
const title = (p: (typeof projects)[number]) => (ko ? p.title : p.title_en ?? p.title);

// 다시 찾은 기관 (2건 이상 의뢰)
const repeat = countBy(projects, (p) => p.client).filter(([, n]) => n >= 2);
const featuredIds = new Set(featured.map((p) => p.id));
---
<Base lang={lang} path="/research" title="Research" description={t(`${stats.projectsTotal}여 건 — 정부부처·공공기관·협회·학회와 수행한 DGU CM Lab의 주요 연구 사례와 연구 분야`, `${stats.projectsTotal}+ projects with ministries, public agencies, associations and societies — key cases and research areas of DGU CM Lab.`)}>
  <PageHero
    eyebrow="Research"
    title="Research"
    sub={t('제도와 현장 사이에서,<br />건설산업의 다음 규칙을 찾습니다', 'Between policy and practice,<br />we find the next rules of construction')}
    lead={t(
      `${stats.projectsTotal}여 건의 연구를 수행했습니다. 정부부처와 공공기관의 정책 연구부터 협회·학회의 산업 연구, 국가 R&D까지 — 그중 대표 사례를 소개합니다.`,
      `${stats.projectsTotal}+ research projects — from policy studies for ministries and public agencies to industry research for associations and societies, and national R&D. Here are the highlights.`,
    )}
  >
    <nav class="area-jump" aria-label={t('페이지 바로가기', 'Jump to')}>
      <a href="#cases" class="chip"><Icon name="flag" size={14} />{t('주요 사례', 'Key cases')}</a>
      <a href="#clients" class="chip"><Icon name="gov" size={14} />{t('발주·협력 기관', 'Clients')}</a>
      {AREA_ORDER.map((k) => (
        <a href={`#area-${k}`} class="chip" style={`--c:${AREAS[k].color}`}><i class="dot"></i>{ko ? AREAS[k].ko : AREAS[k].en}</a>
      ))}
    </nav>
  </PageHero>

  <!-- BY THE NUMBERS -->
  <section class="section section--navy blueprint numbers">
    <div class="container numbers__inner">
      <div class="numbers__big reveal">
        <b class="mono">{stats.projectsTotal}+</b>
        <h2>{t('수행 연구 과제', 'Research projects')}</h2>
      </div>
      <div class="numbers__text reveal" style="--d:.08s">
        <p class="numbers__lead">{t('정책을 만드는 정부부처부터 사업을 발주하는 공공기관, 산업을 대표하는 협회·학회, 현장의 기업까지 — 건설산업의 거의 모든 주체와 함께 연구해 왔습니다.', 'From the ministries that make policy and the agencies that procure projects to the associations, societies and companies that build — we have worked with almost every player in Korean construction.')}</p>
        <ul class="numbers__tags">
          {groups.map((g) => <li>{ko ? g.ko : g.en}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- KEY CASES -->
  <section class="section section--paper2 cases" id="cases">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Key Cases</p>
          <h2 class="h2" style="margin-top:16px">{t('주요 연구 사례', 'Key research cases')}</h2>
        </div>
        <p class="lead">{t('무엇이 문제였고, 어떻게 접근했고, 무엇이 달라졌는지. 연속·후속 과제로 이어진 흐름까지 함께 정리했습니다.', 'What the problem was, how we approached it, and what changed — including the follow-up projects each case led to.')}</p>
      </div>
      <div class="fd-list">
        {featured.map((p, i) => {
          const img = photoImg(p.image);
          const a = AREAS[p.area];
          const s = ko ? p.summary : p.summary_en ?? p.summary;
          const related = (p.related ?? []).map((id) => byId.get(id)).filter(Boolean) as typeof projects;
          return (
            <article class="fd reveal" id={`case-${p.id}`} style={`--c:${a.color}`}>
              <div class="fd__media">
                {img && <Image src={img} alt="" widths={[560, 840, 1120]} sizes="(max-width: 900px) 100vw, 540px" />}
              </div>
              <div class="fd__body">
                <div class="fd__meta">
                  <span class="chip"><i class="dot" style={`--c:${a.color}`}></i>{ko ? a.short : a.shortEn}</span>
                  {isOngoing(p) && <span class="chip chip--live">{t('진행 중', 'Ongoing')}</span>}
                  <span class="mono muted">{period(p, lang)}</span>
                </div>
                <p class="fd__client"><Icon name="gov" size={16} />{clientName(p.client, lang)}</p>
                <h3 class="h3">{title(p)}</h3>
                {s && (
                  <ol class="fd__steps">
                    <li><span class="fd__k">{t('문제', 'Problem')}</span><p>{s.problem}</p></li>
                    <li><span class="fd__k">{t('접근', 'Approach')}</span><p>{s.approach}</p></li>
                    <li><span class="fd__k fd__k--out">{t('성과', 'Impact')}</span><p>{s.outcome}</p></li>
                  </ol>
                )}
                {related.length > 0 && (
                  <div class="fd__related">
                    <p class="mono">{t('연계 과제', 'Related projects')}</p>
                    <ul>
                      {related.map((r) => (
                        <li><span class="mono">{period(r, lang)}</span><span>{title(r)} <span class="muted">· {clientName(r.client, lang)}</span></span></li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <section class="section clients" id="clients">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Clients &amp; Partners</p>
          {ko ? (
            <h2 class="h2" style="margin-top:16px">정부·공공기관·협회·학회가<br /><span>믿고 맡기는</span> 연구실</h2>
          ) : (
            <h2 class="h2" style="margin-top:16px">Ministries, agencies, associations<br />and societies <span>trust our work</span></h2>
          )}
        </div>
        <p class="lead">
          {t(
            '정책을 만드는 정부부처, 사업을 발주하는 공공기관, 산업을 대표하는 협회·단체, 기술을 이끄는 학회와 연구기관까지. 서로 다른 관점의 의뢰를 수행하며 건설산업 전체를 보는 시야를 길렀습니다.',
            'Ministries that make policy, agencies that procure projects, associations that represent the industry, and the societies and institutes that lead its technology. Working for all of them gives us a view of the whole industry.',
          )}
        </p>
      </div>
      <ClientNetwork lang={lang} />
      {repeat.length > 0 && (
        <div class="repeat reveal">
          <p class="repeat__title"><Icon name="check" size={18} />{t('다시 찾은 기관', 'Clients who came back')}</p>
          <ul>
            {repeat.map(([c]) => (
              <li><span>{clientName(c, lang)}</span></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- AREAS -->
  <section class="section section--paper2 areas-detail">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Research Areas</p>
        <h2 class="h2">{t('연구 분야', 'Research areas')}</h2>
      </div>
      {AREA_ORDER.map((k, i) => {
        const a = AREAS[k];
        const top = projects.filter((p) => p.area === k && !featuredIds.has(p.id)).slice(0, 3);
        return (
          <article class:list={['area-row', { 'is-rev': i % 2 === 1 }]} id={`area-${k}`} style={`--c:${a.color}`}>
            <div class="area-row__art reveal">
              <Image src={photoImg(a.illust)!} alt="" widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 500px" quality={80} />
            </div>
            <div class="area-row__body reveal" style="--d:.1s">
              <h3 class="h2">{ko ? a.ko : a.en}</h3>
              {ko && <p class="area-row__en mono">{a.en}</p>}
              <p class="area-row__blurb">{ko ? a.blurb : a.blurbEn}</p>
              <ul class="area-row__tags">{(ko ? a.tags : a.tagsEn).map((tag) => <li>{tag}</li>)}</ul>
              {top.length > 0 && (
                <>
                  <p class="area-row__label mono">{t('이 분야의 다른 과제', 'More in this area')}</p>
                  <ul class="area-row__list">
                    {top.map((p) => (
                      <li>
                        <span class="mono">{isOngoing(p) ? t('진행 중', 'Ongoing') : p.end ?? p.start}</span>
                        <span>{title(p)}<small> · {clientName(p.client, lang)}</small></span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--tight cta-band">
    <div class="container cta-band__inner">
      <p class="cta-band__text">{t('이런 연구에 직접 참여하고 싶다면?', 'Want to work on projects like these?')}</p>
      <div class="cta-band__btns">
        <a class="btn btn--primary" href={L('/join')}>{t('대학원 지원 안내', 'How to apply')} <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={L('/people')}>{t('구성원 보기', 'Meet the team')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .area-jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .area-jump .chip { background: var(--surface); border: 1px solid var(--line); height: 36px; padding: 0 14px; font-size: 14px; transition: border-color .2s; gap: 6px; }
  .area-jump .chip:hover { border-color: var(--ink); }

  .numbers { overflow: hidden; }
  .numbers__inner { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 900px) { .numbers__inner { grid-template-columns: auto 1fr; gap: clamp(48px, 7vw, 112px); } }
  .numbers__big b { display: block; font-size: clamp(72px, 10vw, 132px); font-weight: 600; color: #fff; letter-spacing: -0.06em; line-height: .9; }
  .numbers__big h2 { font-size: 20px; color: #f4a06c; margin-top: 14px; letter-spacing: -0.02em; }
  .numbers__lead { color: #dfe7ef; font-size: clamp(17px, 1.6vw, 20px); line-height: 1.7; font-weight: 500; max-width: 640px; }
  .numbers__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .numbers__tags li { padding: 7px 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,.24); color: #fff; font-size: 14px; font-weight: 600; }

  .cases { overflow: hidden; }
  .fd-list { display: grid; gap: 24px; }
  .fd { display: grid; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; scroll-margin-top: calc(var(--header-h) + 24px); }
  @media (min-width: 900px) { .fd { grid-template-columns: 0.9fr 1.1fr; } .fd:nth-child(even) .fd__media { order: 2; } }
  .fd__media { background: #efede6; min-height: 280px; position: relative; overflow: hidden; }
  .fd__media :global(img) { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  @media (max-width: 899px) { .fd__media { min-height: 0; aspect-ratio: 3 / 2; } }
  .fd__body { padding: clamp(24px, 3.4vw, 44px); display: grid; gap: 12px; align-content: start; }
  .fd__meta { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: 12.5px; }
  .fd__client { display: flex; gap: 8px; align-items: center; font-weight: 700; color: var(--c); font-size: 15px; }
  .fd__steps { list-style: none; display: grid; margin-top: 4px; }
  .fd__steps li { display: grid; grid-template-columns: 72px 1fr; gap: 14px; padding: 13px 0; border-top: 1px dashed var(--line); }
  .fd__k { font-size: 13px; font-weight: 800; color: var(--ink-3); padding-top: 2px; }
  .fd__k--out { color: var(--c); }
  .fd__steps p { font-size: 15.5px; color: var(--ink-2); line-height: 1.7; }
  .fd__related { margin-top: 4px; padding: 16px 18px; border-radius: 10px; background: var(--paper); }
  .fd__related > p { font-size: 12.5px; font-weight: 600; color: var(--orange-ink); letter-spacing: .04em; margin-bottom: 6px; }
  .fd__related ul { list-style: none; display: grid; gap: 6px; }
  .fd__related li { font-size: 14px; font-weight: 600; line-height: 1.55; display: grid; grid-template-columns: 92px 1fr; gap: 8px; }
  .fd__related li > .mono { font-size: 12px; color: var(--ink-3); font-weight: 500; padding-top: 2px; }
  .fd__related .muted { font-weight: 500; }

  .repeat { margin-top: 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding: 18px 22px; border-radius: var(--radius); background: var(--paper-2); }
  .repeat__title { display: flex; align-items: center; gap: 8px; font-weight: 800; color: var(--orange-ink); }
  .repeat ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .repeat li { display: inline-flex; gap: 8px; align-items: center; height: 34px; padding: 0 14px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 14px; font-weight: 600; }
  .repeat b { color: var(--orange-ink); font-size: 13px; }

  .area-row { display: grid; gap: 32px; align-items: center; padding-block: clamp(36px, 5vw, 64px); border-bottom: 1px solid var(--line); scroll-margin-top: var(--header-h); }
  .area-row:last-child { border-bottom: 0; padding-bottom: 0; }
  @media (min-width: 900px) {
    .area-row { grid-template-columns: 0.9fr 1.1fr; gap: 72px; }
    .area-row.is-rev .area-row__art { order: 2; }
  }
  .area-row__art { position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 4 / 3; box-shadow: var(--shadow-2); }
  .area-row__art::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--c); z-index: 1; }
  .area-row__art :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .area-row__no { font-size: 13px; color: var(--c); font-weight: 600; margin-bottom: 14px; }
  .area-row__en { font-size: 13px; color: var(--ink-3); margin-top: 8px; }
  .area-row__blurb { margin-top: 18px; font-size: 17px; color: var(--ink-2); line-height: 1.75; max-width: 560px; }
  .area-row__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .area-row__tags li { font-size: 13.5px; font-weight: 700; padding: 6px 12px; border-radius: 999px; background: color-mix(in srgb, var(--c) 10%, white); color: var(--ink); }
  .area-row__label { margin-top: 28px; font-size: 12.5px; color: var(--ink-3); font-weight: 600; letter-spacing: .04em; padding-bottom: 10px; border-bottom: 1.5px solid var(--ink); }
  .area-row__list { list-style: none; }
  .area-row__list li { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15px; font-weight: 600; line-height: 1.55; }
  .area-row__list li > span:first-child { font-size: 12.5px; color: var(--ink-3); padding-top: 2px; font-weight: 500; }
  .area-row__list small { color: var(--ink-3); font-weight: 500; font-size: 13.5px; }

  .cta-band { border-top: 1px solid var(--line); }
  .cta-band__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .cta-band__text { font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; letter-spacing: -0.03em; }
  .cta-band__btns { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
